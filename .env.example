# Copy this file to .env and fill in real values before running the app.

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# Password required to use the Admin panel (create tracking numbers, log events).
# Pick something long and random — this is the only thing standing between
# the public internet and your admin panel.
ADMIN_PASSWORD=change-this-to-a-strong-password
